# Copier ce fichier en `.env` (ignoré par git) et renseigner la clé.
# Clé d'accès Web3Forms, à créer sur https://web3forms.com
# Elle finit dans le JavaScript du site (préfixe WEB3FORMS_ déclaré dans vite.config.ts) : restreindre le
# domaine autorisé dans le tableau de bord Web3Forms.
WEB3FORMS_ACCESS_KEY=
